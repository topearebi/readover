{
  "name": "ReadOver",
  "short_name": "ReadOver",
  "description": "Continuous vertical media feed for personal notes, epubs, and documents",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#110f17",
  "theme_color": "#110f17",
  "categories": ["productivity", "books", "utilities"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Documents and Notes",
      "accept": {
        "text/markdown": [".md"],
        "text/plain": [".txt"],
        "application/epub+zip": [".epub"],
        "application/pdf": [".pdf"]
      }
    }
  ]
}
